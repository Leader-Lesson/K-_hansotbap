# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.
# 모델 이름은 직접 적지 않아도 된다: npm run models 로 각 서버에서 조회해 번호로 고르면 여기에 저장된다

# ── 1. 무엇을 쓸지 ───────────────────────────────────────────────
# F1 추출·F4 문장 생성: claude | unsloth | lmstudio  (API 장애 시 로컬로 바꿔 시연을 이어간다)
LLM_PROVIDER=claude
# F8 작업표준서 임베딩: unsloth | lmstudio  (Claude API에는 임베딩이 없다. LLM_PROVIDER 와 따로 고른다)
EMBEDDING_PROVIDER=unsloth

# ── 2. Claude API ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# F1 추출 깊이: low | medium | high | xhigh | max (높을수록 느리고 정확). 이름이 CLAUDE_ 로 시작하면 Claude Code 환경변수와 겹친다
LLM_EFFORT=medium
# Claude 안전 분류기가 거절하면 서버가 권장 모델로 다시 돌린다
LLM_FALLBACKS=true

# ── 3. Unsloth Studio (팀 로컬 LLM 노트북, OpenAI 호환, Tailscale Funnel 경유) ──
# 주소(https://….ts.net/v1)와 키는 공개 저장소에 적지 않는다. 팀 채널에서 받아 넣는다
UNSLOTH_BASE_URL=
UNSLOTH_API_KEY=
UNSLOTH_CHAT_MODEL=unsloth/Qwen3.8-Flash-Next-GGUF

# F8 표준서 매칭 순위 보강용 다국어 임베딩 모델(bge-m3 등). 비우면 규칙만 쓴다 (기본 384차원 모델은 한국어를 구분 못 함)
UNSLOTH_EMBEDDING_MODEL=

# ── 4. LM Studio (각자 PC, OpenAI 호환) ────────────────────────────
# LM Studio > Developer 에서 서버를 켠다(기본 1234)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# 인증을 켠 경우만 넣는다. 비우면 키 없이 보낸다
LMSTUDIO_API_KEY=
LMSTUDIO_CHAT_MODEL=
LMSTUDIO_EMBEDDING_MODEL=

# ── 5. Whisper 음성인식 (F7, 각자 PC의 whisper.cpp) ──────────────────
# large-v3-turbo(속도) | large-v3(정확도)
WHISPER_MODEL=large-v3-turbo
# README "음성인식 준비". 백엔드 API(8000)와 겹치지 않게 8090
WHISPER_BASE_URL=http://127.0.0.1:8090/v1
# 키를 검사하는 원격 음성 서버를 쓸 때만 넣는다. 로컬 whisper.cpp면 비워 둔다
WHISPER_API_KEY=
# 받아쓰기 응답 대기(초). NVIDIA GPU 없는 PC(CPU판)는 녹음 길이의 약 2.5배 걸린다
WHISPER_TIMEOUT=1800

# ── 6. 일정 ───────────────────────────────────────────────────────
# 기준 일정(합성 작업 분해표 37건)을 화면·판정에 넣을지. false 면 올린 계획서로만 일정을 만든다
# (예: S1을 보려면 축로I·배관O 계획서를 둘 다 올린다). 바꾸면 백엔드를 다시 켠다
USE_BASELINE=true
