# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.

# claude | lmstudio  (API 장애 시 lmstudio 로 바꿔 시연을 이어간다)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# F1 추출 깊이: low | medium | high | xhigh | max (높을수록 느리고 정확). 이름이 CLAUDE_ 로 시작하면 Claude Code 환경변수와 겹친다
LLM_EFFORT=medium
# Claude 안전 분류기가 거절하면 서버가 권장 모델로 다시 돌린다
LLM_FALLBACKS=true

# LM Studio (OpenAI 호환 로컬 API)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_CHAT_MODEL=
LMSTUDIO_EMBEDDING_MODEL=

# F7 음성인식: large-v3-turbo(속도) | large-v3(정확도)
WHISPER_MODEL=large-v3-turbo
